{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow-editor/flow.schema.json",
  "title": "Flow DSL v0.1",
  "type": "object",
  "required": ["meta", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "mode"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "mode": { "enum": ["trace", "stream"] },
        "direction": { "enum": ["LR", "TB"], "default": "LR" }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "trace": { "$ref": "#/$defs/trace" },
    "stream": { "$ref": "#/$defs/stream" }
  },
  "allOf": [
    {
      "if": { "properties": { "meta": { "properties": { "mode": { "const": "trace" } } } } },
      "then": { "required": ["meta", "nodes", "edges", "trace"] }
    },
    {
      "if": { "properties": { "meta": { "properties": { "mode": { "const": "stream" } } } } },
      "then": { "required": ["meta", "nodes", "edges", "stream"] }
    }
  ],
  "$defs": {
    "kind": { "enum": ["packet", "signal", "data", "error"] },
    "layer": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "fields": { "type": "object", "additionalProperties": { "type": "string" } },
        "locked": { "type": "boolean" }
      }
    },
    "layerOp": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "enum": ["set", "push", "pop", "lock", "unlock"] },
        "layer": {},
        "field": { "type": "string" },
        "value": { "type": "string" },
        "note": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "op": { "const": "set" } } },
          "then": { "required": ["op", "layer", "field", "value"],
                    "properties": { "layer": { "type": "string" } } } },
        { "if": { "properties": { "op": { "const": "push" } } },
          "then": { "required": ["op", "layer"],
                    "properties": { "layer": { "$ref": "#/$defs/layer" } } } },
        { "if": { "properties": { "op": { "enum": ["pop", "lock", "unlock"] } } },
          "then": { "required": ["op", "layer"],
                    "properties": { "layer": { "type": "string" } } } }
      ]
    },
    "mechanism": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["table-lookup", "weighted-select", "rewrite", "crypt", "k8s-resolve", "encap", "decap", "filter", "queue"] },
        "title": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": {
          "type": "object", "required": ["id", "cells"],
          "properties": {
            "id": { "type": "string" },
            "cells": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          } } },
        "candidates": { "type": "array", "items": {
          "type": "object", "required": ["id", "label", "weight"],
          "properties": {
            "id": { "type": "string" },
            "label": { "type": "string" },
            "weight": { "type": "number" }
          } } },
        "changes": { "type": "array", "items": {
          "type": "object", "required": ["layer", "field", "from", "to"],
          "properties": {
            "layer": { "type": "string" },
            "field": { "type": "string" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          } } },
        "mode": { "enum": ["encrypt", "decrypt"] },
        "cipher": { "type": "string" },
        "note": { "type": "string" },
        "layers": { "type": "array", "items": { "type": "string" } },
        "lines": { "type": "array", "items": {
          "type": "object", "required": ["text"],
          "properties": {
            "id": { "type": "string" },
            "text": { "type": "string" },
            "indent": { "type": "integer", "minimum": 0 }
          } } },
        "layer": { "$ref": "#/$defs/layer" },
        "rules": { "type": "array", "items": {
          "type": "object", "required": ["id", "text", "verdict"],
          "properties": {
            "id": { "type": "string" },
            "text": { "type": "string" },
            "verdict": { "type": "string" }
          } } }
      }
    },
    "port": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/kind" },
        "label": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentId": { "type": ["string", "null"] },
        "type": { "type": "string", "minLength": 1 },
        "role": { "enum": ["process", "store", "external", "decision"] },
        "label": { "type": "string", "minLength": 1 },
        "sublabel": { "type": "string" },
        "collapsed": { "type": "boolean" },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in": { "type": "array", "items": { "$ref": "#/$defs/port" } },
            "out": { "type": "array", "items": { "$ref": "#/$defs/port" } }
          }
        },
        "icon": { "type": "string", "maxLength": 8 },
        "info": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
        "detail": { "type": "string" },
        "mechanisms": { "type": "array", "items": { "$ref": "#/$defs/mechanism" } }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "sourcePort": { "type": "string" },
        "targetPort": { "type": "string" },
        "kind": { "$ref": "#/$defs/kind" },
        "label": { "type": "string" },
        "decoration": { "enum": ["one-to-one", "one-to-many", "optional"] },
        "ratio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }
      }
    },
    "trace": {
      "type": "object",
      "required": ["entity", "steps"],
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "object",
          "required": ["kind", "label"],
          "additionalProperties": false,
          "properties": {
            "kind": { "$ref": "#/$defs/kind" },
            "label": { "type": "string" },
            "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["at", "narration"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "string", "minLength": 1 },
              "via": { "type": "string" },
              "narration": { "type": "string", "minLength": 1 },
              "layerOps": { "type": "array", "items": { "$ref": "#/$defs/layerOp" } },
              "mechanismEvent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "select": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rates": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "capacities": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
